+(defun hutch-review-run (buf scopes)
+  "Run the LLM review of SCOPES and render results into hutch buffer BUF.
+Replaces BUF's previous findings.  Returns BUF.
+bndos: extracted from `hutch-magit-review' so callers can supply their own
+buffer and scopes; the cancel functions are now stored in BUF (upstream set
+them in whichever buffer was current, so \[hutch-cancel-review] could not
+reach them)."
+  (hutch--trace-begin)
+  (let ((remaining (length scopes)))
+    (with-current-buffer buf
+      (setq hutch--scopes scopes
+            hutch--results nil
+            hutch--progress nil
+            hutch--discarded nil))
+    (hutch--render-buffer buf)
+    ;; Tools, cache and gptel all resolve the repository from the current
+    ;; buffer, so dispatch from BUF.
+    (let ((cancel-fns
+           (with-current-buffer buf
+            (hutch--review scopes
+                          (lambda (result)
+                            (when (buffer-live-p buf)
+                              (hutch--render-remove-progress buf (hutch--scope-label result))
+                              (hutch--render-result buf result))
+                            (when (zerop (cl-decf remaining)) (hutch--trace-end)))
+                          (lambda (scope current max)
+                            (hutch--render-progress buf scope current max))))))
+      (with-current-buffer buf
+        (setq hutch--cancel-fns cancel-fns)))
+    buf))
 
