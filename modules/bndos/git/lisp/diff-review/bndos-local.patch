+(defun diff-review--view-at (pos)
+  "(SIDE LINE ATTACH) of the view line at POS."
+  (list (get-text-property pos 'diff-review-side) (get-text-property pos 'diff-review-line)
+        (get-text-property pos 'diff-review-attach)))
