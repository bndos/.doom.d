#!/usr/bin/env -S python3 -I
"""Start, prompt and follow coding tasks.

A task is a git worktree (created by worktrunk) whose agent is a session in
the Hydra ACP daemon, so it runs whether or not Emacs is open; Emacs, leader
agents and this command are all clients of the same session.

  bndos-task start [--base REF] [--repo DIR] [--agent ID] [--mode MODE]
                   [--model MODEL] [--ticket ID] [--prompt TEXT | --prompt-file FILE]
                   [--wait] BRANCH-OR-WORKTREE
  bndos-task send TARGET (--prompt TEXT | --prompt-file FILE) [--repo DIR] [--wait]
  bndos-task status [TARGET] [--repo DIR] [--wait STATES|done] [--timeout SECONDS]
  bndos-task sessions TARGET [--agent ID] [--repo DIR]
  bndos-task adopt TARGET --session ID [--agent ID] [--base REF] [--replace] [--repo DIR]
  bndos-task models [--agent ID] [--repo DIR] [--refresh]
  bndos-task context [--repo DIR]
  bndos-task migrate [--repo DIR] [--dry-run]
  bndos-task drafts threads [--repo DIR] [--pr N] [--all]
  bndos-task drafts list [--repo DIR] [--pr N]
  bndos-task drafts lines [--path PATH] [--repo DIR] [--pr N]
  bndos-task drafts hunks (--thread ID | --conversation [--base REF]) [--repo DIR] [--pr N]
  bndos-task drafts add (--thread ID | --conversation | --path PATH [--line N [--start-line M]
                         [--side RIGHT|LEFT]] | --review) (--body TEXT | --body-file FILE)
                        [--quote MESSAGE-ID] [--author NAME] [--repo DIR] [--pr N]
                        [--hunks REF... | --hunks-in PATH... | --hunks-matching REGEXP...]
  bndos-task drafts edit ID [--body TEXT | --body-file FILE] [--hunks... | --unlink]
                        [--repo DIR] [--pr N]
  bndos-task drafts delete ID [--repo DIR] [--pr N]

TARGET is a branch, a worktree directory or a session id.  --agent is a
Hydra agent id, the same as the agent-shell config identifier (claude-code,
codex, ...).  --mode / --model default per agent (Claude: auto; Codex: agent,
i.e. auto review).

start on a task without an agent (none recorded, or missing from Hydra)
starts one there, from its recorded parent; --base is needed only for a
new branch.  start also lists the repository in the Emacs dashboard
(projects.json); project_added says whether it wasn't listed yet.

sessions lists the agent's own earlier conversations in a worktree (one
made before it was a task); adopt makes the one you name the task's
session, through Hydra, so Emacs and leaders can attach to it.  The agent's
command comes from Hydra's config.json.

models lists the models and modes an agent offers (what --model / --mode
accept).  Agents only report them in a session, so start saves them; when
nothing is saved yet, or with --refresh, models asks the agent's adapter
for a session without prompting it.

After sending a prompt, start and send leave a small background process
attached to the session until that turn ends, so a permission request the
agent makes stays open for you (in Emacs) instead of being refused.  --wait
stays in the foreground until the turn ends instead.

A repository can live in a project folder: ~/Projects/rame/rame, the main
checkout, inside ~/Projects/rame, which has a .tasks folder.  Then new
worktrees go beside the main checkout (~/Projects/rame/BRANCH), briefs are
kept in .tasks/briefs, and start, send, status and context report .tasks as
"context", for plans and notes that span tasks.  Otherwise worktrunk's
worktree-path decides.  migrate moves a repository into a project folder of
the same name (~/Projects/foo becomes ~/Projects/foo/foo) with its task
worktrees, records and reviews; it refuses while an agent is working or
waiting, and tasks get a new agent on their next start.  --dry-run reports
what it would move and what to redo by hand.

drafts are what the user may say on a pull request, written for them to
read, change and send as their own: Emacs shows each where it goes and
sends only those the user picks.  add drafts, as an agent's (agent:NAME,
from --author):
  --thread ID       a reply in a review thread (ids from threads);
  --conversation    a comment on the pull request's conversation;
  --path P --line N a comment on line N of P (--start-line M for lines
                    M to N; --side LEFT for removed lines), sent with the
                    user's review;
  --path P          a comment on the whole file P;
  --review          the review's summary, sent with its line comments.
A line comment is on the pull request's head as GitHub has it, on lines
its diff shows (GitHub takes no other): lines lists them, per file.
--quote ID puts a message of the threads or the conversation (its id, from
threads) above the body, quoted.  threads lists the unresolved threads
(or --all) and the conversation, each message with its id.  edit and
delete change only agents' drafts that are still drafts.  The pull request
is the current branch's, or --pr.  Nothing is posted to GitHub from here.

A reply or a comment may link the changes that answer it, for the user to review: hunks
of the diff from the commit its thread was written on (for the
conversation, the latest review's, or --base) to HEAD.  hunks lists them,
each with a ref; --hunks links refs, --hunks-in every hunk in files or
folders, --hunks-matching every hunk whose lines match.  The draft keeps
only where they are; Emacs shows them from git, as they are checked out.

Nothing here commits, pushes, merges or deletes; the worktree is created
and its parent, session and agent are recorded in git config
(branch.<branch>.bndos-*).  Output is JSON on stdout.

Exit codes: 0 ok, 1 failure or unknown target, 2 --wait timed out,
3 the Hydra daemon can't be reached.
"""

import argparse
import datetime
import hashlib
import json
import os
import re
import secrets
import select
import string
import subprocess
import sys
import time
import urllib.error
import urllib.request

HYDRA = os.environ.get("BNDOS_TASK_HYDRA", "hydra-acp")
DEFAULT_AGENT = os.environ.get("BNDOS_TASK_AGENT", "claude-code")
DEFAULT_MODES = {"claude-code": "auto", "codex": "agent"}
STATES = ("working", "waiting", "limited", "idle", "stopped", "missing", "none")


class Failure(Exception):
    def __init__(self, message, code=1, **extra):
        super().__init__(message)
        self.code, self.extra = code, extra


def state_dir():
    if os.environ.get("BNDOS_TASK_STATE_DIR"):
        return os.environ["BNDOS_TASK_STATE_DIR"]
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(base, "bndos-tasks")


def now_ms():
    return int(time.time() * 1000)


def iso(ms):
    return time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(ms / 1000)) if ms else None


def passed(stamp):
    """Whether the time `iso' wrote as STAMP is past; one that isn't a time is."""
    try:
        return datetime.datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%S%z").timestamp() < time.time()
    except (TypeError, ValueError):
        return True


# ---------------------------------------------------------------- git

def git(directory, *args, check=True):
    proc = subprocess.run(["git", "--no-optional-locks", "-C", directory, *args],
                          capture_output=True, text=True)
    if check and proc.returncode != 0:
        raise Failure(f"git {' '.join(args)}: {proc.stderr.strip() or proc.returncode}")
    return proc.stdout.strip() if proc.returncode == 0 else None


def set_task_config(directory, branch, **values):
    for name, value in values.items():
        if value is not None:
            git(directory, "config", f"branch.{branch}.bndos-{name}", str(value))


def task_configs(directory):
    """{branch: {name: value}} for every branch.<b>.bndos-<name> in the repository."""
    out = git(directory, "config", "--null", "--get-regexp", r"^branch\..*\.bndos-", check=False) or ""
    configs = {}
    for entry in filter(None, out.split("\0")):
        key, _, value = entry.partition("\n")
        branch, _, name = key[len("branch."):].rpartition(".bndos-")
        configs.setdefault(branch, {})[name] = value
    return configs


def worktrees(repo):
    """REPO's worktrees as dicts with path and branch, the main one first;
    not diff-review's own, under the git directory's review/worktrees."""
    out = git(repo, "worktree", "list", "--porcelain")
    own = os.path.join(os.path.realpath(git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir")),
                       "review", "worktrees", "")
    trees, current = [], {}
    for line in out.splitlines() + [""]:
        if not line:
            if current and not os.path.realpath(current["path"]).startswith(own):
                trees.append(current)
            current = {}
        elif line.startswith("worktree "):
            current["path"] = line[len("worktree "):]
        elif line.startswith("branch refs/heads/"):
            current["branch"] = line[len("branch refs/heads/"):]
        elif line == "locked" or line.startswith("locked "):
            current["locked"] = True
    return trees


def common_dir(directory):
    return os.path.realpath(git(directory, "rev-parse", "--path-format=absolute", "--git-common-dir"))


def task_key(common, worktree):
    """Emacs's task key (bndos-task-key): its review record's file name."""
    text = os.path.realpath(common).rstrip("/") + "\n" + os.path.realpath(worktree).rstrip("/")
    return hashlib.sha1(text.encode()).hexdigest()[:16]


TASKS_DIR = ".tasks"


def container(directory):
    """The folder the repository of DIRECTORY lives in as a project, or None:
    its main checkout's parent, when that holds a .tasks folder."""
    common = common_dir(directory)
    if os.path.basename(common) != ".git":
        return None
    parent = os.path.dirname(os.path.dirname(common))
    return parent if os.path.isdir(os.path.join(parent, TASKS_DIR)) else None


def context_dir(directory):
    """The project's .tasks folder (plans, briefs), or None outside a container."""
    folder = container(directory)
    return folder and os.path.join(folder, TASKS_DIR)


def task_log(worktree):
    return os.path.join(state_dir(), "logs", task_key(common_dir(worktree), worktree) + ".log")


def review_summary(common, worktree, branch):
    """The task's review state (Emacs's record) and its unresolved threads.

Threads are the comments of the task's diff-review file; a record from
before that keeps them itself."""
    key = task_key(common, worktree)
    try:
        with open(os.path.join(state_dir(), "tasks", key + ".json")) as f:
            record = json.load(f)
    except (OSError, ValueError):
        record = None
    review_file = os.path.join(common, "review", (branch or f"task-{key}") + ".json")
    try:
        with open(review_file) as f:
            comments = json.load(f).get("comments") or []
        unresolved = sum(1 for c in comments if not c.get("resolved"))
    except (OSError, ValueError):
        unresolved = sum(1 for t in ((record or {}).get("threads") or []) if t.get("state") != "resolved")
    if record is None and not unresolved:
        return None, 0
    return ((record or {}).get("review") or {}).get("state"), unresolved


# ---------------------------------------------------------------- Hydra REST

def hydra_home():
    return os.environ.get("HYDRA_ACP_HOME") or os.path.expanduser("~/.hydra-acp")


def hydra_get(path, start_daemon=True):
    home = hydra_home()
    try:
        with open(os.path.join(home, "config.json")) as f:
            daemon = json.load(f).get("daemon") or {}
    except (OSError, ValueError):
        daemon = {}
    url = f"http://{daemon.get('host', '127.0.0.1')}:{daemon.get('port', 55514)}{path}"
    try:
        with open(os.path.join(home, "auth-token")) as f:
            token = f.read().strip()
        request = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
        with urllib.request.urlopen(request, timeout=10) as response:
            return json.load(response)
    except (OSError, urllib.error.URLError) as err:
        if start_daemon:
            # Like the shim, bring the daemon up on first use (it restores
            # sessions from disk), then ask once more.
            subprocess.run([HYDRA, "daemon", "start"], capture_output=True, env=hydra_env())
            return hydra_get(path, start_daemon=False)
        raise Failure(f"can't reach the Hydra daemon at {url}: {err}", code=3)


def hydra_env():
    return dict(os.environ, NO_UPDATE_NOTIFIER="1")


def hydra_sessions():
    return {s["sessionId"]: s for s in hydra_get("/v1/sessions?includeNonInteractive=1").get("sessions", [])}


# ---------------------------------------------------------------- ACP client

class AcpError(Exception):
    pass


class Acp:
    """A JSON-RPC client over a Hydra shim's stdio.  No threads, so it survives fork."""

    def __init__(self, argv, cwd, log_path, env=None):
        os.makedirs(os.path.dirname(log_path), exist_ok=True)
        self.log_path = log_path
        log = open(log_path, "ab")
        # Its own session, so a leader's tool runner killing our process
        # group doesn't take the connection with it.
        self.proc = subprocess.Popen(argv, cwd=cwd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=log, bufsize=0, env=env or hydra_env(), start_new_session=True)
        log.close()
        self.buffer, self.next_id = b"", 0

    def send(self, obj):
        self.proc.stdin.write((json.dumps(obj) + "\n").encode())

    def request(self, method, params):
        self.next_id += 1
        self.send({"jsonrpc": "2.0", "id": self.next_id, "method": method, "params": params})
        return self.next_id

    def _message(self, deadline):
        fd = self.proc.stdout.fileno()
        while b"\n" not in self.buffer:
            wait = None if deadline is None else max(0, deadline - time.time())
            if not select.select([fd], [], [], wait)[0]:
                return None
            chunk = os.read(fd, 65536)
            if not chunk:
                raise EOFError("the Hydra shim exited")
            self.buffer += chunk
        line, self.buffer = self.buffer.split(b"\n", 1)
        return json.loads(line) if line.strip() else {}

    def wait(self, rid, timeout=None, on_notification=None):
        deadline = None if timeout is None else time.time() + timeout
        while True:
            msg = self._message(deadline)
            if msg is None:
                raise AcpError("timed out waiting for the agent")
            if "method" in msg and "id" not in msg:
                if on_notification:
                    on_notification(msg)
            elif "method" in msg and msg["method"] != "session/request_permission":
                # Permission requests are left for an interactive client to
                # answer; nothing else is expected from the daemon.
                self.send({"jsonrpc": "2.0", "id": msg["id"],
                           "error": {"code": -32601, "message": "not supported by bndos-task"}})
            elif msg.get("id") == rid and "method" not in msg:
                if "error" in msg:
                    raise AcpError(msg["error"].get("message") or json.dumps(msg["error"]))
                return msg.get("result") or {}

    def call(self, method, params, timeout=120):
        return self.wait(self.request(method, params), timeout)

    def stderr_tail(self):
        try:
            with open(self.log_path, "rb") as f:
                return f.read()[-800:].decode(errors="replace").strip()
        except OSError:
            return ""

    def close(self):
        try:
            self.proc.stdin.close()
            self.proc.wait(timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            self.proc.kill()


def initialize(acp):
    acp.call("initialize", {"protocolVersion": 1, "clientCapabilities": {},
                            "clientInfo": {"name": "bndos-task", "version": "1"}})


# A usage limit, recorded per task in git config (branch.<b>.bndos-limit) by
# whichever client sees it: Claude reports it as `_meta' on usage updates while
# it waits out the limit inside the turn; other agents only say so.  Emacs
# records it the same way from agent-shell (bndos-task-agent.el).
LIMIT_TEXT = re.compile(r"(?:usage|rate) limit(?: has been)? (?:reached|exceeded)"
                        r"|(?:hit|reached) (?:your|the) (?:usage|rate) limit"
                        r"|limit reached\s*[·∙|]\s*resets", re.I)


def set_limit(worktree, branch, limit):
    if limit is None:
        git(worktree, "config", "--unset", f"branch.{branch}.bndos-limit", check=False)
    else:
        git(worktree, "config", f"branch.{branch}.bndos-limit", json.dumps(limit))


def limit_of(info):
    """A limit record from Claude's rate-limit info, or None once it's lifted."""
    if info.get("status") not in ("allowed_warning", "rejected"):
        return None
    resets = info.get("resetsAt")
    return {"status": info["status"], "type": info.get("rateLimitType"),
            "resets_at": iso(resets * 1000) if isinstance(resets, (int, float)) else None,
            "utilization": info.get("utilization"), "source": "claude"}


class LimitTracker:
    """Records the usage limits a turn reports, as it reports them."""

    def __init__(self, worktree, branch):
        self.worktree, self.branch, self.limit, self.text = worktree, branch, None, ""
        set_limit(worktree, branch, None)   # a new prompt: whatever held the last one is past

    def notification(self, msg):
        update = (msg.get("params") or {}).get("update") or {}
        if update.get("sessionUpdate") == "usage_update":
            info = (update.get("_meta") or {}).get("_claude/rateLimit")
            if isinstance(info, dict):
                self.limit = limit_of(info)
                set_limit(self.worktree, self.branch, self.limit)
        elif update.get("sessionUpdate") == "agent_message_chunk":
            self.text = (self.text + ((update.get("content") or {}).get("text") or ""))[-600:]

    def turn_ended(self, stop_reason, error=None):
        if self.limit and self.limit["status"] == "rejected" and stop_reason == "end_turn":
            self.limit = None   # it got through
            set_limit(self.worktree, self.branch, None)
        elif not self.limit and (match := LIMIT_TEXT.search(f"{self.text}\n{error or ''}")):
            line = next(l for l in f"{self.text}\n{error or ''}".splitlines() if LIMIT_TEXT.search(l))
            self.limit = {"status": "rejected", "type": None, "resets_at": None, "utilization": None,
                          "source": "message", "message": line.strip()[:200]}
            set_limit(self.worktree, self.branch, self.limit)


def prompt_and_follow(acp, session_id, text, wait, result):
    """Send TEXT, print RESULT, then follow the turn (in the foreground with WAIT),
    recording a usage limit it hits."""
    tracker = LimitTracker(result["worktree"], result["branch"])
    rid = acp.request("session/prompt", {"sessionId": session_id,
                                         "prompt": [{"type": "text", "text": text}]})

    def follow():
        try:
            stop = acp.wait(rid, on_notification=tracker.notification).get("stopReason")
        except AcpError as err:
            tracker.turn_ended(None, str(err))
            raise
        tracker.turn_ended(stop)
        return stop

    if wait:
        print("bndos-task: waiting for the turn to end (permission requests are answered in Emacs)",
              file=sys.stderr)
        result["stop_reason"] = follow()
        result["limit"] = tracker.limit
        emit(result)
        acp.close()
        return
    emit(result)
    sys.stdout.flush()
    ready_r, ready_w = os.pipe()
    if os.fork():
        os.close(ready_w)
        os.read(ready_r, 1)  # the follower has left our process group
        os._exit(0)
    os.close(ready_r)
    os.setsid()
    null = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(null, fd)
    os.write(ready_w, b"x")
    os.close(ready_w)
    try:
        follow()
    except (EOFError, AcpError, OSError):
        pass
    acp.close()
    os._exit(0)


# ---------------------------------------------------------------- commands

def emit(obj):
    print(json.dumps(obj, indent=1))


def read_prompt(args):
    if args.prompt_file:
        with open(args.prompt_file) as f:
            return f.read()
    return args.prompt or ""


def existing_task(target, repo):
    """The worktree TARGET (a branch or a directory) names, or None when it names none."""
    path = os.path.realpath(target) if os.path.isdir(target) else None
    main, *trees = worktrees(git(path or repo, "rev-parse", "--show-toplevel"))
    tree = next((t for t in trees if t.get("branch") == target or os.path.realpath(t["path"]) == path), None)
    if tree is None:
        return None
    if tree.get("branch") not in task_configs(main["path"]):
        raise Failure(f"{target} is a worktree but not a task")
    task = resolve(tree["path"], repo)
    if task["state"] not in ("none", "missing"):
        raise Failure(f"{task['branch']} already has an agent ({task['session_id']}): use send")
    return task


def remember_project(directory):
    """List DIRECTORY's repository in the dashboard (projects.json, as Emacs's
    bndos-task-remember-project does); whether it was new."""
    main = os.path.dirname(common_dir(directory)) + "/"
    path = os.path.join(state_dir(), "projects.json")
    try:
        with open(path) as f:
            dirs = json.load(f)
    except (OSError, ValueError):
        dirs = []
    if not isinstance(dirs, list):
        dirs = []
    if any(isinstance(d, str) and os.path.realpath(d) == main.rstrip("/") for d in dirs):
        return False
    os.makedirs(os.path.dirname(path), exist_ok=True)
    write_json(path, dirs + [main])
    return True


def cmd_start(args):
    task = existing_task(args.branch, args.repo)
    if task is None and not args.base:
        raise Failure(f"--base is needed for a new branch ({args.branch})")
    prompt = read_prompt(args)
    agent = args.agent or (task and task["agent"]) or DEFAULT_AGENT
    mode = args.mode if args.mode is not None else DEFAULT_MODES.get(agent)
    if task:
        repo, branch, worktree = task["repo"], task["branch"], task["worktree"]
        base, ticket = args.base or task["parent"], args.ticket or task["ticket"]
    else:
        repo = git(args.repo, "rev-parse", "--show-toplevel")
        branch, base, ticket = args.branch, args.base, args.ticket
        env = dict(os.environ)
        if folder := container(repo):   # worktrees beside the main checkout, in the project's folder
            env["WORKTRUNK_WORKTREE_PATH"] = os.path.join(folder, "{{ branch | sanitize }}")
        proc = subprocess.run(["wt", "switch", "--create", branch, "--base", base,
                               "--no-cd", "--format", "json"], cwd=repo, capture_output=True, text=True, env=env)
        if proc.returncode != 0:
            raise Failure(f"wt switch --create: {(proc.stderr or proc.stdout).strip()}")
        worktree = os.path.realpath(json.loads(proc.stdout)["path"])
    set_task_config(worktree, branch, base=base, agent=agent, ticket=ticket)
    result = {"protocol": "bndos-task/1", "status": "started", "branch": branch,
              "worktree": worktree, "parent": base, "agent": agent, "ticket": ticket,
              "existing": task is not None, "context": context_dir(worktree), "warnings": []}
    result["project_added"] = remember_project(worktree)
    log = task_log(worktree)
    acp = Acp([HYDRA, "launch", agent], worktree, log)
    try:
        initialize(acp)
        project = os.path.basename(repo)
        session = acp.call("session/new", {"cwd": worktree, "mcpServers": [],
                                           "_meta": {"hydra-acp": {"title": f"{project}/{branch}"}}})
    except (AcpError, EOFError) as err:
        acp.close()
        raise Failure(f"couldn't start a {agent} session: {err}", worktree=worktree,
                      log=acp.stderr_tail())
    session_id = session["sessionId"]
    set_task_config(worktree, branch, session=session_id)
    save_agent_options(agent, session)
    result["session_id"] = session_id
    current_mode = (session.get("modes") or {}).get("currentModeId")
    if mode and mode != current_mode:
        try:
            acp.call("session/set_mode", {"sessionId": session_id, "modeId": mode})
            current_mode = mode
        except AcpError as err:
            result["warnings"].append(f"mode {mode} refused ({err}); the agent is in {current_mode}")
    model_option = config_option(session, "model")
    current_model = (model_option.get("currentValue") if model_option
                     else (session.get("models") or {}).get("currentModelId"))
    if args.model and args.model != current_model:
        try:
            if model_option:
                acp.call("session/set_config_option", {"sessionId": session_id, "configId": model_option["id"],
                                                       "value": args.model})
            else:
                acp.call("session/set_model", {"sessionId": session_id, "modelId": args.model})
            current_model = args.model
        except AcpError as err:
            result["warnings"].append(f"model {args.model} refused ({err}); using {current_model}")
    result.update(mode=current_mode, requested_mode=mode, model=current_model)
    if not prompt.strip():
        acp.close()
        emit(result)
        return
    save_brief(worktree, branch, prompt)
    set_task_config(worktree, branch, prompted=now_ms())
    prompt_and_follow(acp, session_id, prompt, args.wait, result)


def save_brief(worktree, branch, prompt):
    """Keep the task's first prompt, which AI reviews get as the change's goal;
    in a project folder, among its briefs too."""
    paths = [os.path.join(state_dir(), "briefs", task_key(common_dir(worktree), worktree) + ".md")]
    if context := context_dir(worktree):
        paths.append(os.path.join(context, "briefs", branch.replace("/", "-") + ".md"))
    for path in paths:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(prompt)


def cmd_send(args):
    task = resolve(args.target, args.repo)
    if not task.get("session_id"):
        raise Failure(f"{args.target} has no session")
    prompt = read_prompt(args)
    if not prompt.strip():
        raise Failure("nothing to send")
    log = task_log(task["worktree"])
    acp = Acp([HYDRA, "acp"], task["worktree"], log)
    try:
        initialize(acp)
        acp.call("session/attach", {"sessionId": task["session_id"], "historyPolicy": "none"})
    except (AcpError, EOFError) as err:
        acp.close()
        raise Failure(f"couldn't attach to {task['session_id']}: {err}", log=acp.stderr_tail())
    set_task_config(task["worktree"], task["branch"], prompted=now_ms())
    result = {"protocol": "bndos-task/1", "status": "sent", "branch": task["branch"],
              "worktree": task["worktree"], "session_id": task["session_id"], "context": task["context"],
              "queued": task["state"] in ("working", "waiting")}
    prompt_and_follow(acp, task["session_id"], prompt, args.wait, result)


def agent_command(agent):
    """ARGV and environment that run AGENT's ACP adapter directly (from Hydra's config)."""
    path = os.path.join(hydra_home(), "config.json")
    try:
        with open(path) as f:
            entry = (json.load(f).get("agents") or {}).get(agent)
    except (OSError, ValueError):
        entry = None
    if not entry:
        raise Failure(f"agent {agent} isn't defined in {path}, so its conversations can't be listed")
    return ([entry.get("command") or agent, *(entry.get("args") or [])],
            dict(os.environ, **(entry.get("env") or {})))


def agent_options_path(agent):
    return os.path.join(state_dir(), "agents", f"{agent}.json")


def config_option(session, category):
    """SESSION's config option of CATEGORY, preferring the one whose id is CATEGORY.

Agents now report model and mode as config options; agent-shell prefers
them too, as some agents tag several options with the same category."""
    matches = [o for o in session.get("configOptions") or [] if o.get("category") == category]
    return next((o for o in matches if o.get("id") == category), matches[0] if matches else None)


def option_values(option):
    """A select option's values, flattening groups."""
    values = []
    for value in option.get("options") or []:
        if "value" not in value and "options" in value:
            values += option_values(value)
        else:
            values.append({"id": value.get("value"), "name": value.get("name"),
                           "description": value.get("description")})
    return values


def session_choices(session, category, legacy_key, list_key, current_key, id_key):
    option = config_option(session, category)
    if option:
        return option_values(option), option.get("currentValue")
    legacy = session.get(legacy_key) or {}
    return ([{"id": m.get(id_key), "name": m.get("name"), "description": m.get("description")}
             for m in legacy.get(list_key) or []],
            legacy.get(current_key))


def save_agent_options(agent, session):
    """Remember the models and modes AGENT reported in SESSION (a session/new result)."""
    models, current_model = session_choices(session, "model", "models", "availableModels",
                                            "currentModelId", "modelId")
    modes, current_mode = session_choices(session, "mode", "modes", "availableModes", "currentModeId", "id")
    options = {"agent": agent, "updated_at": iso(now_ms()), "models": models,
               "current_model": current_model, "modes": modes, "current_mode": current_mode}
    path = agent_options_path(agent)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(options, f, indent=1)
    os.replace(tmp, path)
    return options


def cmd_models(args):
    agent = args.agent or DEFAULT_AGENT
    options = None
    if not args.refresh:
        try:
            with open(agent_options_path(agent)) as f:
                options, source = json.load(f), "saved"
        except (OSError, ValueError):
            pass
    if options is None:
        argv, env = agent_command(agent)
        cwd = os.path.realpath(args.repo)
        acp = Acp(argv, cwd, os.path.join(state_dir(), "logs", f"models-{agent}.log"), env=env)
        try:
            initialize(acp)
            session = acp.call("session/new", {"cwd": cwd, "mcpServers": []})
        except (AcpError, EOFError) as err:
            raise Failure(f"{agent} couldn't report its models: {err}", log=acp.stderr_tail())
        finally:
            acp.close()
        options, source = save_agent_options(agent, session), "agent"
    emit({"protocol": "bndos-task/1", **options, "default_mode": DEFAULT_MODES.get(agent), "source": source})


def cmd_sessions(args):
    task = resolve(args.target, args.repo)
    agent = args.agent or task["agent"] or DEFAULT_AGENT
    argv, env = agent_command(agent)
    acp = Acp(argv, task["worktree"], task_log(task["worktree"]), env=env)
    found, cursor = [], None
    try:
        initialize(acp)
        while True:
            page = acp.call("session/list", {"cwd": task["worktree"], **({"cursor": cursor} if cursor else {})})
            found += page.get("sessions") or []
            cursor = page.get("nextCursor")
            if not cursor:
                break
    except (AcpError, EOFError) as err:
        raise Failure(f"{agent} couldn't list its conversations: {err}", log=acp.stderr_tail())
    finally:
        acp.close()
    here = [s for s in found if not s.get("cwd") or os.path.realpath(s["cwd"]) == task["worktree"]]
    here.sort(key=lambda s: s.get("updatedAt") or "", reverse=True)
    emit({"protocol": "bndos-task/1", "branch": task["branch"], "worktree": task["worktree"], "agent": agent,
          "session_id": task["session_id"],
          "sessions": [{"id": s["sessionId"], "title": s.get("title"), "updated_at": s.get("updatedAt")}
                       for s in here]})


def cmd_adopt(args):
    if args.session.startswith("hydra_session_"):
        raise Failure(f"{args.session} is a Hydra session, not the agent's conversation id")
    task = resolve(args.target, args.repo)
    if task["session_id"] and not args.replace:
        raise Failure(f"{task['branch']} already has session {task['session_id']} (--replace to change it)")
    agent = args.agent or task["agent"] or DEFAULT_AGENT
    session_id = "hydra_session_" + "".join(secrets.choice(string.ascii_letters + string.digits) for _ in range(16))
    acp = Acp([HYDRA, "acp"], task["worktree"], task_log(task["worktree"]))
    try:
        initialize(acp)
        # Attaching to an id Hydra doesn't know, with resume hints, makes it
        # load that conversation into the agent and keep it as a session.
        result = acp.call("session/attach", {
            "sessionId": session_id, "historyPolicy": "none",
            "_meta": {"hydra-acp": {"resume": {"upstreamSessionId": args.session, "agentId": agent,
                                               "cwd": task["worktree"]}}}})
    except (AcpError, EOFError) as err:
        raise Failure(f"couldn't adopt {args.session}: {err}", log=acp.stderr_tail())
    finally:
        acp.close()
    set_task_config(task["worktree"], task["branch"], session=result.get("sessionId") or session_id,
                    agent=agent, base=args.base)
    emit({"protocol": "bndos-task/1", "status": "adopted", "branch": task["branch"],
          "worktree": task["worktree"], "agent": agent, "session_id": result.get("sessionId") or session_id,
          "upstream_session_id": args.session, "previous_session_id": task["session_id"],
          "parent": args.base or task["parent"],
          "mode": (result.get("modes") or {}).get("currentModeId")})


def describe(repo, tree, config, sessions, common):
    session_id = config.get("session")
    session = sessions.get(session_id) if session_id else None
    if not session_id:
        state = "none"
    elif not session:
        state = "missing"
    elif session.get("busy"):
        state = "waiting" if session.get("awaitingInput") else "working"
    else:
        state = "idle" if session.get("status") == "warm" else "stopped"
    prompted = int(config.get("prompted") or 0) or None
    ended = session.get("lastTurnEndedAt") if session else None
    try:
        limit = json.loads(config["limit"]) if config.get("limit") else None
    except ValueError:
        limit = None
    if not isinstance(limit, dict) or (limit.get("resets_at") and passed(limit["resets_at"])):
        limit = None
    limited = bool(limit and limit.get("status") == "rejected" and state in ("working", "idle", "stopped"))
    if limited:
        state = "limited"
    review, unresolved = review_summary(common, tree["path"], tree.get("branch"))
    return {"protocol": "bndos-task-status/2", "branch": tree.get("branch"),
            "worktree": os.path.realpath(tree["path"]), "repo": repo,
            "parent": config.get("base"), "ticket": config.get("ticket"),
            "agent": config.get("agent"), "session_id": session_id, "state": state,
            "done": bool(state in ("idle", "stopped") and prompted and ended and ended >= prompted),
            "limit": limit,
            "model": session.get("currentModel") if session else None,
            "title": session.get("title") if session else None,
            "attached_clients": session.get("attachedClients") if session else 0,
            "prompted_at": iso(prompted), "last_turn_ended_at": iso(ended),
            "review": review, "unresolved_threads": unresolved}


def all_tasks(repo):
    """Every worktree of REPO but the main one, with its task state."""
    main, *trees = worktrees(git(repo, "rev-parse", "--show-toplevel"))
    common = common_dir(main["path"])
    configs = task_configs(main["path"])
    # Only ask Hydra (possibly starting its daemon) when there's a session.
    sessions = hydra_sessions() if any("session" in c for c in configs.values()) else {}
    context = context_dir(main["path"])
    return [dict(describe(main["path"], tree, configs.get(tree.get("branch"), {}), sessions, common),
                 context=context)
            for tree in trees]


def resolve(target, repo):
    path = os.path.realpath(target) if os.path.isdir(target) else None
    if path:
        repo = path
    matches = [t for t in all_tasks(repo)
               if target in (t["branch"], t["session_id"]) or t["worktree"] == path]
    if len(matches) != 1:
        raise Failure(f"{'no' if not matches else 'more than one'} task matches {target}")
    return matches[0]


def cmd_status(args):
    if not args.wait:
        emit(resolve(args.target, args.repo) if args.target else all_tasks(args.repo))
        return
    if not args.target:
        raise Failure("--wait needs a target")
    wanted = set(args.wait.split(","))
    unknown = wanted - set(STATES) - {"done"}
    if unknown:
        raise Failure(f"unknown state {', '.join(sorted(unknown))}; use {', '.join(STATES)} or done")
    deadline = time.time() + args.timeout
    while True:
        task = resolve(args.target, args.repo)
        if task["state"] in wanted or ("done" in wanted and task["done"]):
            emit(task)
            return
        if time.time() > deadline:
            raise Failure(f"{args.target} is still {task['state']} after {args.timeout}s", code=2, task=task)
        time.sleep(2)


def write_json(path, value):
    """Write VALUE to PATH whole or not at all."""
    tmp = f"{path}.{secrets.token_hex(4)}.tmp"
    with open(tmp, "w") as f:
        json.dump(value, f, indent=1)
    os.replace(tmp, path)


GH = os.environ.get("BNDOS_TASK_GH", "gh")
DRAFT_MARKER = re.compile(r"\n*<!-- bndos-draft:([A-Za-z0-9-]+) -->\s*\Z")
THREADS_QUERY = """query($owner: String!, $name: String!, $number: Int!, $after: String) {
  repository(owner: $owner, name: $name) { pullRequest(number: $number) {
    reviewThreads(first: 50, after: $after) {
      pageInfo { hasNextPage endCursor }
      nodes { id isResolved isOutdated path line originalLine
        comments(first: 100) { %s } } }
    comments(last: 100) { nodes { id body createdAt author { login } } }
    reviews(last: 100) { nodes { id body state submittedAt author { login } commit { oid } } } } } }"""
COMMENT_FIELDS = ("pageInfo { hasNextPage endCursor } "
                  "nodes { databaseId body createdAt author { login } originalCommit { oid } }")
COMMENTS_QUERY = """query($id: ID!, $after: String) {
  node(id: $id) { ... on PullRequestReviewThread {
    comments(first: 100, after: $after) { %s } } } }""" % COMMENT_FIELDS
THREADS_QUERY = THREADS_QUERY % COMMENT_FIELDS


def gh_json(directory, *args):
    proc = subprocess.run([GH, *args], cwd=directory, capture_output=True, text=True, encoding="utf-8",
                          env={**os.environ, "GH_PROMPT_DISABLED": "1", "NO_COLOR": "1"})
    if proc.returncode != 0:
        raise Failure(f"gh {args[0]}: {proc.stderr.strip() or proc.returncode}")
    return json.loads(proc.stdout)


def pull_request(repo, number):
    pr = gh_json(repo, "pr", "view", *([str(number)] if number else []), "--json", "number,url,headRefOid,baseRefOid")
    match = re.search(r"github\.com/([^/]+)/([^/]+)/pull/", pr.get("url", ""))
    if not match:
        raise Failure("not a GitHub pull request")
    return ({"owner": match[1], "name": match[2], "number": pr["number"]},
            {"head": pr.get("headRefOid"), "base": pr.get("baseRefOid")})


def pr_threads(repo, pr):
    """PR's review threads and its latest conversation comments."""
    threads, conversation, reviews, after = [], None, None, None
    while True:
        args = ["api", "graphql", "-f", f"query={THREADS_QUERY}", "-f", f"owner={pr['owner']}",
                "-f", f"name={pr['name']}", "-F", f"number={pr['number']}"]
        if after:
            args += ["-f", f"after={after}"]
        data = gh_json(repo, *args)["data"]["repository"]["pullRequest"]
        if conversation is None:
            conversation = data["comments"]["nodes"]
            # A review's summary, with something said: GitHub shows it in the
            # conversation, answered there.
            reviews = [dict(r, createdAt=r.get("submittedAt")) for r in (data.get("reviews") or {}).get("nodes", [])
                       if r.get("submittedAt") and ((r.get("body") or "").strip()
                                                    or r.get("state") in ("APPROVED", "CHANGES_REQUESTED"))]
        page = data["reviewThreads"]
        threads += page["nodes"]
        if not page["pageInfo"]["hasNextPage"]:
            break
        after = page["pageInfo"]["endCursor"]
    # A thread's comments past its first page.
    for thread in threads:
        comments = thread["comments"]
        while comments["pageInfo"]["hasNextPage"]:
            more = gh_json(repo, "api", "graphql", "-f", f"query={COMMENTS_QUERY}", "-f", f"id={thread['id']}",
                           "-f", f"after={comments['pageInfo']['endCursor']}")["data"]["node"]["comments"]
            comments["nodes"] += more["nodes"]
            comments["pageInfo"] = more["pageInfo"]
    return threads, sorted(conversation + reviews, key=lambda c: c.get("createdAt") or "")


def gh_message(node):
    message = {"id": str(node["databaseId"]) if node.get("databaseId") else node.get("id"),
               "author": "@" + ((node.get("author") or {}).get("login") or "ghost"),
               "at": node.get("createdAt"), "body": DRAFT_MARKER.sub("", node.get("body") or "")}
    if node.get("state"):
        message["review"] = node["state"].lower()
    return message


def draft_store(repo, pr):
    store = os.path.join(common_dir(repo), "review", "github", pr["owner"], pr["name"], str(pr["number"]))
    for state in ("drafts", "sending", "sent"):
        os.makedirs(os.path.join(store, state), exist_ok=True)
    return store


def changes_text(changes):
    """CHANGES as the hash of a draft takes them, as Emacs does."""
    links = sorted(f"link:{l['id']}@{l['path']}:{l['from']}-{l['to']}" for l in changes.get("links") or [])
    rules = sorted("rule:in:" + ",".join(r["in"]) if "in" in r else "rule:matching:" + r["matching"]
                   for r in changes.get("rules") or [])
    return "\n".join([f"base:{changes.get('base')}", f"head:{changes.get('head')}", *links, *rules])


def draft_hash(draft):
    text = draft.get("body") or ""
    if draft.get("changes"):
        text += "\0" + changes_text(draft["changes"])
    return hashlib.sha256(text.encode()).hexdigest()


# --- The changes a reply links: hunks of `git diff -U0' from the commit
# commented on, kept as an id and a place in that base; never diff text.

HUNK_HEADER = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")


def hunk_id(path, minus, plus):
    return hashlib.sha256(f"{path}\0{chr(10).join(minus)}\0{chr(10).join(plus)}".encode()).hexdigest()[:16]


def git_out(repo, *args):
    proc = subprocess.run(["git", "--no-optional-locks", "-c", "core.quotePath=false", *args], cwd=repo,
                          capture_output=True, text=True, encoding="utf-8")
    if proc.returncode != 0:
        raise Failure(f"git {args[0]}: {proc.stderr.strip()}")
    return proc.stdout


def diff_hunks(repo, base, target):
    out = git_out(repo, "diff", "-U0", "--no-color", "--no-ext-diff", "--no-renames",
                  "--src-prefix=a/", "--dst-prefix=b/", base, target, "--")
    hunks, path, old_path, hunk = [], None, None, None
    for line in out.split("\n"):
        if line.startswith("diff --git "):
            path = old_path = hunk = None
        # A file's header, until its first hunk: a removed "-- x" is a line.
        elif hunk is None and line.startswith("--- "):
            old_path = None if line == "--- /dev/null" else line[6:].rstrip("\t")
        elif hunk is None and line.startswith("+++ "):
            path = old_path if line == "+++ /dev/null" else line[6:].rstrip("\t")
        elif m := HUNK_HEADER.match(line):
            hunk = {"path": path or old_path, "old": int(m[1]), "old_len": int(m[2] or 1),
                    "new": int(m[3]), "new_len": int(m[4] or 1), "minus": [], "plus": []}
            hunks.append(hunk)
        elif hunk is not None and line[:1] == "-":
            hunk["minus"].append(line[1:])
        elif hunk is not None and line[:1] == "+":
            hunk["plus"].append(line[1:])
    for h in hunks:
        h["id"] = hunk_id(h["path"], h["minus"], h["plus"])
        h["from"], h["to"] = (h["old"], h["old"] + h["old_len"] - 1) if h["old_len"] else (h["old"] + 1, h["old"])
        h["ref"] = f"{h['id'][:12]}@{h['path']}:{h['from']}"
    return hunks


def have_commit(repo, sha):
    """Whether SHA is here, fetched from origin if need be."""
    def here():
        return subprocess.run(["git", "cat-file", "-e", f"{sha}^{{commit}}"], cwd=repo,
                              capture_output=True).returncode == 0
    if here():
        return True
    subprocess.run(["git", "fetch", "-q", "origin", sha], cwd=repo, capture_output=True)
    return here()


def reply_base(repo, args, threads, conversation, refs):
    """The commit a reply's changes are taken from: the one its thread was
    written on; for the conversation --base, the latest review's commit, or
    where the branch left its base."""
    if getattr(args, "thread", None):
        thread = next((t for t in threads if t["id"] == args.thread), None)
        if not thread:
            raise Failure(f"no review thread {args.thread}")
        base = ((thread["comments"]["nodes"][0].get("originalCommit")) or {}).get("oid")
        if not base:
            raise Failure("the thread has no commit it was written on")
    elif getattr(args, "base", None):
        base = git_out(repo, "rev-parse", "--verify", f"{args.base}^{{commit}}").strip()
    else:
        reviewed = [c for c in conversation if c.get("commit")]
        base = (reviewed[-1]["commit"]["oid"] if reviewed
                else git_out(repo, "merge-base", "HEAD", refs["base"]).strip() if refs.get("base") and have_commit(repo, refs["base"])
                else None)
        if not base:
            raise Failure("no commit to take changes from: give --base")
    if not have_commit(repo, base):
        raise Failure(f"commit {base[:12]} isn't here, nor on origin")
    return base


def linked_changes(repo, base, refs_given, paths, patterns):
    """The links REFS_GIVEN, PATHS and PATTERNS name among the hunks from BASE
    to HEAD, or a Failure; nil when none is asked for."""
    if not (refs_given or paths or patterns):
        return None
    head = git_out(repo, "rev-parse", "HEAD").strip()
    hunks = diff_hunks(repo, base, head)
    chosen = []
    for ref in refs_given or []:
        prefix, _, place = ref.partition("@")
        path, _, start = place.rpartition(":")
        match = [h for h in hunks if h["id"].startswith(prefix) and len(prefix) >= 8
                 and (not place or (h["path"] == path and str(h["from"]) == start))]
        if len(match) != 1:
            raise Failure(f"{ref}: {'no' if not match else len(match)} hunk(s) like it between "
                          f"{base[:12]} and HEAD (see drafts hunks)")
        chosen += match
    rules = []
    if paths:
        rules.append({"in": paths})
        chosen += [h for h in hunks if any(h["path"] == p or h["path"].startswith(p.rstrip("/") + "/") for p in paths)]
    for pattern in patterns or []:
        try:
            regexp = re.compile(pattern)
        except re.error as e:
            raise Failure(f"--hunks-matching {pattern}: {e}")
        rules.append({"matching": pattern})
        chosen += [h for h in hunks if any(regexp.search(l) for l in h["minus"] + h["plus"])]
    if not chosen:
        raise Failure("nothing linked: no hunk between the base and HEAD is like that")
    links = sorted({(h["id"], h["path"], h["from"], h["to"]) for h in chosen}, key=lambda l: (l[1], l[2], l[0]))
    return {"base": base, "head": head,
            "links": [{"id": i, "path": p, "from": f, "to": t} for i, p, f, t in links], "rules": rules}


def pr_diff_lines(repo, refs, path=None):
    """The lines of the pull request's diff, as GitHub shows it (3 lines of
    context): {path: {"RIGHT": [(from, to)...], "LEFT": [...]}}, of its head
    on GitHub."""
    head, base = refs.get("head"), refs.get("base")
    if not (head and base and have_commit(repo, head) and have_commit(repo, base)):
        raise Failure("the pull request's head or base isn't here, nor on origin")
    merge_base = git_out(repo, "merge-base", base, head).strip()
    out = git_out(repo, "diff", "-U3", "--no-color", "--no-ext-diff", "--no-renames",
                  "--src-prefix=a/", "--dst-prefix=b/", merge_base, head, "--", *([path] if path else []))
    files, current, hunk = {}, None, False
    for line in out.split("\n"):
        if line.startswith("diff --git "):
            current, hunk = None, False
        elif not hunk and line.startswith("+++ "):
            current = line[6:].rstrip("\t") if line != "+++ /dev/null" else current
        elif not hunk and line.startswith("--- "):
            current = line[6:].rstrip("\t") if line != "--- /dev/null" else None
        elif m := HUNK_HEADER.match(line):
            hunk = True
            ranges = files.setdefault(current, {"RIGHT": [], "LEFT": []})
            old, old_len, new, new_len = int(m[1]), int(m[2] or 1), int(m[3]), int(m[4] or 1)
            if new_len:
                ranges["RIGHT"].append((new, new + new_len - 1))
            if old_len:
                ranges["LEFT"].append((old, old + old_len - 1))
    return files


def ranges_text(ranges):
    return ", ".join(f"{a}" if a == b else f"{a}-{b}" for a, b in ranges) or "none"


def line_target(repo, refs, args):
    """A comment on lines of a file, or on the file: its target, or a Failure
    when GitHub wouldn't take it."""
    files = pr_diff_lines(repo, refs, args.path)
    if args.path not in files:
        raise Failure(f"{args.path} isn't changed by the pull request: comments go on its changed files")
    if args.line is None:
        if args.start_line is not None or args.side:
            raise Failure("--start-line and --side are for a comment on lines: give --line")
        return {"kind": "file", "path": args.path, "commit": refs["head"]}
    side = (args.side or "RIGHT").upper()
    if side not in ("RIGHT", "LEFT"):
        raise Failure("--side is RIGHT (the lines as changed) or LEFT (removed lines)")
    start = args.start_line if args.start_line is not None else args.line
    if start > args.line:
        raise Failure("--start-line is after --line")
    ranges = files[args.path][side]
    if not any(a <= start and args.line <= b for a, b in ranges):
        raise Failure(f"{args.path}:{start if start == args.line else f'{start}-{args.line}'} ({side}) isn't in one "
                      f"hunk of the pull request's diff, so GitHub won't take it; lines there: {ranges_text(ranges)}")
    target = {"kind": "line", "path": args.path, "line": args.line, "side": side, "commit": refs["head"]}
    if start != args.line:
        target["start_line"] = start
    return target


def quoted(text):
    return "\n".join("> " + l if l.strip() else ">" for l in text.rstrip().split("\n"))


def find_message(threads, conversation, message_id):
    for thread in threads:
        for node in thread["comments"]["nodes"]:
            if str(node.get("databaseId")) == message_id:
                return node
    return next((c for c in conversation if c.get("id") == message_id), None)


def load_drafts(store):
    drafts = []
    for state in ("drafts", "sending", "sent"):
        folder = os.path.join(store, state)
        for name in sorted(os.listdir(folder)):
            if name.startswith(".") or not name.endswith(".json"):
                continue
            try:
                with open(os.path.join(folder, name), encoding="utf-8") as f:
                    draft = json.load(f)
            except (OSError, ValueError):
                continue
            drafts.append({**draft, "state": state, "hash": draft_hash(draft)})
    return sorted(drafts, key=lambda d: d.get("created") or "")


def read_body(args):
    body = args.body
    if args.body_file:
        with open(args.body_file, encoding="utf-8") as f:
            body = f.read()
    body = (body or "").strip()
    if not body:
        raise Failure("nothing to say: the body is empty")
    return body


def hold_agent_draft(store, draft_id):
    """Take an agent's draft out of reach of a send while it is changed: the
    held file and the draft, or a Failure."""
    path = os.path.join(store, "drafts", f"{draft_id}.json")
    held = os.path.join(store, "drafts", f".{draft_id}.held-{os.getpid()}")
    try:
        os.rename(path, held)
    except FileNotFoundError:
        raise Failure(f"no draft {draft_id} to change: sent, being sent, deleted or being changed")
    with open(held, encoding="utf-8") as f:
        draft = json.load(f)
    if not (draft.get("author") or "").startswith("agent:"):
        move_no_replace(held, path)
        raise Failure(f"draft {draft_id} is the user's: only agents' drafts change from here")
    return held, path, draft


def move_no_replace(source, target):
    """Move SOURCE to TARGET only if nothing is there: whether it moved."""
    try:
        os.link(source, target)
    except FileExistsError:
        return False
    os.unlink(source)
    return True


def cmd_drafts(args):
    pr, refs = pull_request(args.repo, args.pr)
    store = draft_store(args.repo, pr)
    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    if args.action == "threads":
        threads, conversation = pr_threads(args.repo, pr)
        emit({"protocol": "bndos-task/1", "pull_request": pr, "head": refs.get("head"),
              "threads": [{"id": t["id"], "path": t["path"], "line": t.get("line") or t.get("originalLine"),
                           "commit": ((t["comments"]["nodes"][0].get("originalCommit") or {}).get("oid")
                                      if t["comments"]["nodes"] else None),
                           "resolved": t["isResolved"], "outdated": t["isOutdated"],
                           "messages": [gh_message(c) for c in t["comments"]["nodes"]]}
                          for t in threads if args.all or not t["isResolved"]],
              "conversation": [gh_message(c) for c in conversation]})
    elif args.action == "list":
        emit({"protocol": "bndos-task/1", "pull_request": pr, "drafts": load_drafts(store)})
    elif args.action == "lines":
        files = pr_diff_lines(args.repo, refs, args.path)
        if args.path and args.path not in files:
            raise Failure(f"{args.path} isn't changed by the pull request")
        emit({"protocol": "bndos-task/1", "pull_request": pr, "head": refs["head"],
              "files": [{"path": p, "right": [list(r) for r in ranges["RIGHT"]],
                         "left": [list(r) for r in ranges["LEFT"]]} for p, ranges in sorted(files.items())]})
    elif args.action == "hunks":
        threads, conversation = pr_threads(args.repo, pr)
        base = reply_base(args.repo, args, threads, conversation, refs)
        head = git_out(args.repo, "rev-parse", "HEAD").strip()
        dirty = bool(git_out(args.repo, "status", "--porcelain", "--untracked-files=no").strip())
        emit({"protocol": "bndos-task/1", "pull_request": pr, "base": base, "head": head,
              "pushed": head == refs.get("head"), "uncommitted": dirty,
              "hunks": [{"ref": h["ref"], "path": h["path"], "line": h["new"],
                         "removes": h["minus"], "adds": h["plus"]} for h in diff_hunks(args.repo, base, head)]})
    elif args.action == "add":
        body = read_body(args)
        threads, conversation = pr_threads(args.repo, pr)
        linking = args.hunks or args.hunks_in or args.hunks_matching
        if linking and not (args.thread or args.conversation):
            raise Failure("changes are linked to replies and comments on the conversation")
        if (args.line is not None or args.start_line is not None or args.side) and not args.path:
            raise Failure("--line, --start-line and --side go with --path")
        if args.quote:
            node = find_message(threads, conversation, args.quote)
            if not node:
                raise Failure(f"no message {args.quote} on the pull request (ids from threads)")
            body = quoted(DRAFT_MARKER.sub("", node.get("body") or "")) + "\n\n" + body
        seen = None
        if args.thread:
            thread = next((t for t in threads if t["id"] == args.thread), None)
            if not thread:
                raise Failure(f"no review thread {args.thread} on {pr['owner']}/{pr['name']}#{pr['number']}")
            comments = thread["comments"]["nodes"]
            target = {"kind": "reply", "thread": thread["id"], "comment": comments[0]["databaseId"],
                      "path": thread["path"], "line": thread.get("line") or thread.get("originalLine")}
            seen = max(c["createdAt"] for c in comments)
        elif args.path:
            target = line_target(args.repo, refs, args)
        elif args.review:
            live = [d for d in load_drafts(store) if d["state"] != "sent"
                    and (d.get("target") or {}).get("kind") == "summary"]
            if live:
                raise Failure(f"the review's summary is drafted already ({live[0]['id']}): edit it")
            target = {"kind": "summary"}
        else:
            target = {"kind": "comment"}
            seen = max((c["createdAt"] for c in conversation), default=None)
        author = args.author if args.author.startswith("agent:") else f"agent:{args.author}"
        changes = linked_changes(args.repo, reply_base(args.repo, args, threads, conversation, refs),
                                 args.hunks, args.hunks_in, args.hunks_matching) \
            if linking else None
        draft_id = f"d{datetime.datetime.now(datetime.timezone.utc):%Y%m%d%H%M%S}-{secrets.token_hex(4)}"
        draft = {"version": 1, "id": draft_id, "pr": pr, "target": target, "body": body, "author": author,
                 "seen": seen, "created": now, "updated": now}
        if changes:
            draft["changes"] = changes
        tmp = os.path.join(store, "drafts", f".new-{secrets.token_hex(6)}")
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(draft, f, indent=1)
        if not move_no_replace(tmp, os.path.join(store, "drafts", f"{draft_id}.json")):
            os.unlink(tmp)
            raise Failure("a draft with that id is there already: try again")
        emit({"protocol": "bndos-task/1", "status": "drafted", "draft": {**draft, "state": "drafts"}})
    elif args.action == "edit":
        relink = args.hunks or args.hunks_in or args.hunks_matching
        if not (args.body or args.body_file or relink or args.unlink):
            raise Failure("nothing to change: give a body, changes to link, or --unlink")
        body = read_body(args) if (args.body or args.body_file) else None
        changes = None
        if relink:
            # Linked anew from the same base as before, or the target's.
            with open(os.path.join(store, "drafts", f"{args.id}.json"), encoding="utf-8") as f:
                target = json.load(f).get("target") or {}
            threads, conversation = pr_threads(args.repo, pr)
            where = argparse.Namespace(thread=target.get("thread"), base=args.base)
            changes = linked_changes(args.repo, reply_base(args.repo, where, threads, conversation, refs),
                                     args.hunks, args.hunks_in, args.hunks_matching)
        held, path, draft = hold_agent_draft(store, args.id)
        if body is not None:
            draft["body"] = body
        if changes:
            draft["changes"] = changes
        elif args.unlink:
            draft.pop("changes", None)
        draft["updated"] = now
        with open(held, "w", encoding="utf-8") as f:
            json.dump(draft, f, indent=1)
        if not move_no_replace(held, path):
            raise Failure(f"draft {args.id} came back meanwhile; the edit is kept in {held}")
        emit({"protocol": "bndos-task/1", "status": "edited", "draft": {**draft, "state": "drafts"}})
    elif args.action == "delete":
        held, _, draft = hold_agent_draft(store, args.id)
        os.unlink(held)
        emit({"protocol": "bndos-task/1", "status": "deleted", "id": args.id})


def migrate_plan(repo):
    """What moving REPO into a project folder of its own would do, or a Failure
    saying why it can't now."""
    main, *trees = worktrees(git(repo, "rev-parse", "--show-toplevel"))
    main_path = os.path.realpath(main["path"])
    common = common_dir(main_path)
    if common != os.path.join(main_path, ".git"):
        raise Failure(f"{main_path} isn't an ordinary checkout (its git directory is {common})")
    if container(main_path):
        raise Failure(f"{main_path} is already in a project folder ({container(main_path)})")
    folder, name = main_path, os.path.basename(main_path)
    new_main = os.path.join(folder, name)
    temp = f"{main_path}.bndos-migrate"
    if os.path.exists(temp):
        raise Failure(f"{temp} is in the way")
    configs = task_configs(main_path)
    sessions = hydra_sessions() if any("session" in c for c in configs.values()) else {}
    moves, busy, targets = [], [], set()
    for tree in trees:
        branch = tree.get("branch")
        state = describe(main_path, tree, configs.get(branch, {}), sessions, common)["state"]
        if state in ("working", "waiting"):
            busy.append(f"{branch} is {state}")
        target = os.path.join(folder, (branch or os.path.basename(tree["path"])).replace("/", "-"))
        if os.path.basename(target) in (name, TASKS_DIR) or os.path.exists(target) or target in targets:
            raise Failure(f"{branch}'s worktree can't go to {target}: the name is taken")
        targets.add(target)
        moves.append({"branch": branch, "from": os.path.realpath(tree["path"]), "to": target,
                      "locked": "locked" in tree})
    if busy:
        raise Failure("finish or stop these tasks first: " + "; ".join(busy))
    locked = [m["branch"] for m in moves if m["locked"]]
    if locked:
        raise Failure(f"locked worktrees can't be moved: {', '.join(locked)} (git worktree unlock)")
    dropped = sorted(b for b, c in configs.items() if c.get("session"))
    olds = [m["from"] for m in moves] + [main_path]
    cwds = []
    out = subprocess.run(["lsof", "-d", "cwd", "-Fpcn"], capture_output=True, text=True).stdout
    proc = {}
    for line in out.splitlines():
        if line[:1] == "p":
            proc = {"pid": int(line[1:])}
        elif line[:1] == "c":
            proc["command"] = line[1:]
        elif line[:1] == "n" and any(line[1:] == o or line[1:].startswith(o + "/") for o in olds):
            cwds.append(f"{proc.get('command')} (pid {proc.get('pid')}) in {line[1:]}")
    follow_up = [f"reopen in Emacs any file open from {main_path} or a task worktree"]
    for venv in (".venv", "venv", "env"):
        if os.path.exists(os.path.join(main_path, venv, "pyvenv.cfg")):
            follow_up.append(f"recreate the virtualenv {os.path.join(new_main, venv)}: its scripts name the old path")
    if os.path.exists(os.path.join(main_path, ".envrc")):
        follow_up.append(f"run direnv allow in {new_main}")
    if cwds:
        follow_up.append("restart what ran in the old folders: " + "; ".join(cwds))
    if dropped:
        follow_up.append("start gives these tasks a new agent (the old conversations stay in Hydra): "
                         + ", ".join(dropped))
    return {"folder": folder, "main": new_main, "from": main_path, "temp": temp, "common": common,
            "worktrees": moves, "sessions_dropped": dropped, "follow_up": follow_up}


def cmd_migrate(args):
    plan = migrate_plan(args.repo)
    report = {k: v for k, v in plan.items() if k not in ("temp", "common")}
    if args.dry_run:
        emit({"protocol": "bndos-task/1", "status": "planned", **report})
        return
    folder, new_main, old_main, old_common = plan["folder"], plan["main"], plan["from"], plan["common"]
    # The repo one level down, in a folder of the same name.
    os.rename(old_main, plan["temp"])
    try:
        os.mkdir(folder)
        os.rename(plan["temp"], new_main)
    except OSError:
        if os.path.isdir(folder) and not os.listdir(folder):
            os.rmdir(folder)
        os.rename(plan["temp"], old_main)
        raise
    os.makedirs(os.path.join(folder, TASKS_DIR, "briefs"), exist_ok=True)
    git(new_main, "worktree", "repair")
    remap = {old_main: new_main}

    def moved(path):
        path = os.path.realpath(path) if os.path.exists(path) else path.rstrip("/")
        for old, new in sorted(remap.items(), key=lambda kv: -len(kv[0])):
            if path == old or path.startswith(old + "/"):
                return new + path[len(old):]
        return path

    for move in plan["worktrees"]:
        git(new_main, "worktree", "move", moved(move["from"]), move["to"])
        remap[move["from"]] = move["to"]
    new_common = common_dir(new_main)
    for branch in plan["sessions_dropped"]:
        git(new_main, "config", "--unset", f"branch.{branch}.bndos-session")
    # Emacs's records, briefs and logs, by the new keys; review files' roots.
    store = state_dir()
    tasks_dir = os.path.join(store, "tasks")
    for entry in sorted(os.listdir(tasks_dir)) if os.path.isdir(tasks_dir) else []:
        path = os.path.join(tasks_dir, entry)
        try:
            with open(path) as f:
                record = json.load(f)
        except (OSError, ValueError):
            continue
        repo_info, tree = record.get("repo") or {}, record.get("worktree") or {}
        if os.path.realpath(repo_info.get("common-dir") or "/") != old_common:
            continue
        old_key, wt = record.get("key"), moved(tree.get("path") or old_main)
        key = task_key(new_common, wt)
        record.update(key=key)
        repo_info.update({"common-dir": new_common, "main-path": new_main + "/"})
        tree.update({"path": wt + "/", "handle": os.path.basename(wt)})
        if isinstance(record.get("agent"), dict):
            record["agent"].pop("session-id", None)
        write_json(os.path.join(tasks_dir, key + ".json"), record)
        if key != old_key:
            os.remove(path)
        for sub, ext in (("briefs", ".md"), ("logs", ".log")):
            old = os.path.join(store, sub, f"{old_key}{ext}")
            if os.path.exists(old):
                os.replace(old, os.path.join(store, sub, f"{key}{ext}"))
        brief = os.path.join(store, "briefs", key + ".md")
        if os.path.exists(brief) and record.get("branch"):
            with open(brief) as src, open(os.path.join(folder, TASKS_DIR, "briefs",
                                                       record["branch"].replace("/", "-") + ".md"), "w") as dst:
                dst.write(src.read())
    reviews = os.path.join(new_common, "review")
    for entry in os.listdir(reviews) if os.path.isdir(reviews) else []:
        path = os.path.join(reviews, entry)
        if not entry.endswith(".json") or not os.path.isfile(path):
            continue
        with open(path) as f:
            review = json.load(f)
        if isinstance(review.get("root"), str) and moved(review["root"]) != review["root"].rstrip("/"):
            review["root"] = moved(review["root"]) + "/"
            write_json(path, review)
    projects = os.path.join(store, "projects.json")
    if os.path.exists(projects):
        with open(projects) as f:
            dirs = json.load(f)
        write_json(projects, [new_main + "/" if os.path.realpath(d) == old_main else d for d in dirs])
    emit({"protocol": "bndos-task/1", "status": "migrated", "context": os.path.join(folder, TASKS_DIR), **report})


def cmd_context(args):
    folder = container(args.repo)
    emit({"protocol": "bndos-task/1", "container": folder, "context": folder and os.path.join(folder, TASKS_DIR)})


def main():
    parser = argparse.ArgumentParser(prog="bndos-task", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    def prompt_args(p):
        group = p.add_mutually_exclusive_group()
        group.add_argument("--prompt")
        group.add_argument("--prompt-file")
        p.add_argument("--wait", action="store_true", help="stay until the turn ends")

    start = sub.add_parser("start", help="create a worktree (or take a task's) and start its agent")
    start.add_argument("branch", metavar="BRANCH-OR-WORKTREE")
    start.add_argument("--repo", default=os.getcwd())
    start.add_argument("--base", help="the new branch's parent (default for a task: its recorded one)")
    start.add_argument("--agent")
    start.add_argument("--mode")
    start.add_argument("--model")
    start.add_argument("--ticket")
    prompt_args(start)
    start.set_defaults(fn=cmd_start)

    send = sub.add_parser("send", help="send a task's agent a prompt")
    send.add_argument("target")
    send.add_argument("--repo", default=os.getcwd())
    prompt_args(send)
    send.set_defaults(fn=cmd_send)

    status = sub.add_parser("status", help="report or wait for task state")
    status.add_argument("target", nargs="?")
    status.add_argument("--repo", default=os.getcwd())
    status.add_argument("--wait", metavar="STATES|done")
    status.add_argument("--timeout", type=int, default=1800)
    status.set_defaults(fn=cmd_status)

    sessions = sub.add_parser("sessions", help="list the agent's earlier conversations in a worktree")
    sessions.add_argument("target")
    sessions.add_argument("--repo", default=os.getcwd())
    sessions.add_argument("--agent")
    sessions.set_defaults(fn=cmd_sessions)

    adopt = sub.add_parser("adopt", help="make an earlier conversation the task's session")
    adopt.add_argument("target")
    adopt.add_argument("--repo", default=os.getcwd())
    adopt.add_argument("--agent")
    adopt.add_argument("--session", required=True, help="the agent's conversation id (see sessions)")
    adopt.add_argument("--base", help="also record the parent branch")
    adopt.add_argument("--replace", action="store_true", help="replace a session already recorded")
    adopt.set_defaults(fn=cmd_adopt)

    migrate = sub.add_parser("migrate", help="move the repository into a project folder of its own")
    migrate.add_argument("--repo", default=os.getcwd())
    migrate.add_argument("--dry-run", action="store_true", help="report what would happen, change nothing")
    migrate.set_defaults(fn=cmd_migrate)

    context = sub.add_parser("context", help="the project folder's .tasks folder, if the repo is in one")
    context.add_argument("--repo", default=os.getcwd())
    context.set_defaults(fn=cmd_context)

    drafts = sub.add_parser("drafts", help="draft replies to a pull request's threads, for the user to send")
    drafts_sub = drafts.add_subparsers(dest="action", required=True)

    def drafts_args(p):
        p.add_argument("--repo", default=os.getcwd())
        p.add_argument("--pr", type=int, help="the pull request (default: the current branch's)")
        p.set_defaults(fn=cmd_drafts)

    def body_args(p, required=True):
        group = p.add_mutually_exclusive_group(required=required)
        group.add_argument("--body")
        group.add_argument("--body-file")

    def changes_args(p):
        p.add_argument("--hunks", nargs="+", metavar="REF", help="hunks from `drafts hunks` that answer it")
        p.add_argument("--hunks-in", nargs="+", metavar="PATH", help="every hunk in these files or folders")
        p.add_argument("--hunks-matching", nargs="+", metavar="REGEXP",
                       help="every hunk whose removed or added lines match")
        p.add_argument("--base", help="for the conversation: the commit changes are taken from "
                                      "(default the latest review's)")

    d = drafts_sub.add_parser("threads", help="the pull request's review threads, with their ids")
    d.add_argument("--all", action="store_true", help="resolved threads too")
    drafts_args(d)
    drafts_args(drafts_sub.add_parser("list", help="the drafts, being sent and sent"))
    d = drafts_sub.add_parser("lines", help="the lines of the pull request's diff, which line comments go on")
    d.add_argument("--path", help="only this file")
    drafts_args(d)
    d = drafts_sub.add_parser("hunks", help="the hunks a reply can link: from the commit commented on to HEAD")
    target = d.add_mutually_exclusive_group(required=True)
    target.add_argument("--thread", help="the review thread's id (from threads)")
    target.add_argument("--conversation", action="store_true", help="a comment on the pull request")
    d.add_argument("--base", help="for the conversation: the commit to start from (default the latest review's)")
    drafts_args(d)
    d = drafts_sub.add_parser("add", help="draft a reply, a comment, a line comment or the review's summary")
    target = d.add_mutually_exclusive_group(required=True)
    target.add_argument("--thread", help="the review thread's id (from threads)")
    target.add_argument("--conversation", action="store_true", help="a comment on the pull request")
    target.add_argument("--path", help="a comment on this file, or on --line of it, sent with the review")
    target.add_argument("--review", action="store_true", help="the review's summary")
    d.add_argument("--line", type=int, help="with --path: the (last) line commented on")
    d.add_argument("--start-line", type=int, help="with --line: the first line")
    d.add_argument("--side", help="with --line: RIGHT, the lines as changed (default), or LEFT, removed lines")
    d.add_argument("--quote", metavar="MESSAGE-ID", help="quote this message (an id from threads) above the body")
    body_args(d)
    changes_args(d)
    d.add_argument("--author", default=os.environ.get("BNDOS_TASK_AGENT", "agent"),
                   help="the agent drafting (stored as agent:NAME)")
    drafts_args(d)
    d = drafts_sub.add_parser("edit", help="change an agent's draft: its body, the changes it links")
    d.add_argument("id")
    body_args(d, required=False)
    changes_args(d)
    d.add_argument("--unlink", action="store_true", help="link no changes")
    drafts_args(d)
    d = drafts_sub.add_parser("delete", help="delete an agent's draft")
    d.add_argument("id")
    drafts_args(d)

    models = sub.add_parser("models", help="list the models and modes an agent offers")
    models.add_argument("--agent")
    models.add_argument("--repo", default=os.getcwd(), help="directory to ask the agent from")
    models.add_argument("--refresh", action="store_true", help="ask the agent even if they're saved")
    models.set_defaults(fn=cmd_models)

    args = parser.parse_args()
    try:
        args.fn(args)
    except Failure as err:
        emit({"protocol": "bndos-task/1", "status": "failed", "error": str(err), **err.extra})
        print(f"bndos-task: {err}", file=sys.stderr)
        sys.exit(err.code)


if __name__ == "__main__":
    main()
