;;; ein-regression-tests.el --- Regression tests for the bndos ein/markdown modules -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)

(defun bndos-ein-test--load ()
  "Load EIN and the module code under test.  Run inside Doom.
Autoload files are loaded eagerly so their private helpers exist before tests
stub them; otherwise the first autoloaded call would redefine the stubs."
  (bndos-ein-load)
  (dolist (module '("ein" "markdown"))
    (dolist (file (file-expand-wildcards
                   (file-name-concat doom-user-dir "modules/bndos" module "autoload/*.el")))
      (load file nil t)))
  (require 'ein-markdown-mode)
  (require 'markdown-mode)
  (require 'python))

(defun bndos-ein-test--overlay-count (symbol)
  (if (boundp symbol)
      (length (symbol-value symbol))
    0))

(ert-deftest bndos-ein-test-mret-binding-is-inline-render-next ()
  :tags '(ein-regression)
  (bndos-ein-test--load)
  (with-temp-buffer
    (ein:markdown-mode)
    (should (eq (local-key-binding (kbd "M-RET"))
                'bndos/ein-run-cell-and-next))))

(ert-deftest bndos-ein-test-python-comments-do-not-render-as-markdown ()
  :tags '(ein-regression)
  (bndos-ein-test--load)
  (with-temp-buffer
    (rename-buffer " *ein: http://127.0.0.1:9999/rabi_tutorial.ipynb*[python]" t)
    (let ((python-mode-hook nil))
      (python-mode))
    (insert "# | not | markdown |
# |---|---|
# $a_\pi$
")
    (cl-letf (((symbol-function 'bndos-ein-goto-next-input)
               (lambda (&rest _) nil))
              ((symbol-function 'ein:worksheet-execute-cell)
               (lambda (&rest _) (interactive) nil)))
      (bndos/ein-run-cell-and-next))
    (should-not (bndos-ein-markdown-context-p))
    (should (= 0 (bndos-ein-test--overlay-count 'bndos-markdown-style-overlays)))
    (should (= 0 (bndos-ein-test--overlay-count 'bndos-markdown-latex-overlays)))))


(ert-deftest bndos-ein-test-python-lsp-temp-backing-survives ()
  :tags '(ein-regression)
  (bndos-ein-test--load)
  (let ((orig-require (symbol-function 'require))
        lsp-proxy-mode-called)
    (with-temp-buffer
      (rename-buffer " *ein: http://127.0.0.1:9999/rabi_tutorial.ipynb*[python]" t)
      (let ((python-mode-hook nil))
        (python-mode))
      (should (bndos-ein-python-cell-buffer-p))
      (cl-letf (((symbol-function 'require)
                 (lambda (feature &optional filename noerror)
                   (if (eq feature 'lsp-proxy)
                       t
                     (funcall orig-require feature filename noerror))))
                ((symbol-function 'lsp-proxy-mode)
                 (lambda (&optional _arg)
                   (setq lsp-proxy-mode-called t)
                   (setq-local lsp-proxy-mode t)))
                ((symbol-function 'bndos-ein--copilot-reopen)
                 (lambda () nil)))
        (bndos-ein-python-lsp-setup))
      (should buffer-file-name)
      (should (string-prefix-p (file-name-as-directory bndos-ein-lsp-temp-dir)
                               buffer-file-name))
      (should (or lsp-proxy-mode-called (bound-and-true-p lsp-proxy-mode))))))

(ert-deftest bndos-ein-test-edit-buffer-render-targets-notebook-buffer ()
  :tags '(ein-regression)
  (bndos-ein-test--load)
  (let* ((base (generate-new-buffer "*ein: test.ipynb*"))
         (edit (make-indirect-buffer base " *ein: test.ipynb*[ein:markdown]" t))
         rendered-buffer fallback-render-called)
    (unwind-protect
        (with-current-buffer edit
          (setq major-mode 'ein:markdown-mode)
          (cl-letf (((symbol-function 'ein:worksheet-get-current-cell)
                     (lambda (&rest _) 'fake-cell))
                    ((symbol-function 'ein:markdowncell-p)
                     (lambda (cell) (eq cell 'fake-cell)))
                    ((symbol-function 'bndos-ein--render-cell)
                     (lambda (_cell) (setq rendered-buffer (current-buffer))))
                    ((symbol-function 'bndos/markdown-render)
                     (lambda () (setq fallback-render-called t))))
            (bndos/ein-render-markdown)))
      (when (buffer-live-p edit) (kill-buffer edit))
      (when (buffer-live-p base) (kill-buffer base)))
    (should (eq rendered-buffer base))
    (should-not fallback-render-called)))

(ert-deftest bndos-ein-test-mret-from-edit-buffer-closes-duplicate-edit-windows ()
  :tags '(ein-regression)
  (bndos-ein-test--load)
  (let* ((base (generate-new-buffer "*ein: test.ipynb*"))
         (edit (make-indirect-buffer base " *ein: test.ipynb*[ein:markdown]" t))
         advanced-buffer)
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (switch-to-buffer edit)
          (let ((other (split-window-right)))
            (set-window-buffer other edit))
          (with-current-buffer edit
            (setq major-mode 'ein:markdown-mode)
            (cl-letf (((symbol-function 'bndos-ein--notebook-buffer)
                       (lambda () base))
                      ((symbol-function 'ein:worksheet-get-current-ewoc-node)
                       (lambda () 'fake-ewoc-node))
                      ((symbol-function 'ein:worksheet-goto-next-input)
                       (lambda (node)
                         (should (eq node 'fake-ewoc-node))
                         (setq advanced-buffer (current-buffer))))
                      ((symbol-function 'pop-to-buffer)
                       (lambda (&rest _) (error "pop-to-buffer must not be used"))))
              (bndos-ein-goto-next-input)))
          (should (eq advanced-buffer base))
          (should-not (cl-find-if (lambda (window)
                                    (eq (window-buffer window) edit))
                                  (window-list)))
          (should (cl-find-if (lambda (window)
                                (eq (window-buffer window) base))
                              (window-list))))
      (when (buffer-live-p edit) (kill-buffer edit))
      (when (buffer-live-p base) (kill-buffer base)))))



(ert-deftest bndos-ein-test-edit-block-clear-keeps-other-markdown-renders ()
  :tags '(ein-regression)
  (bndos-ein-test--load)
  (with-temp-buffer
    (insert "markdown:
# First

In [ ]:
print(1)

markdown:
# Second
")
    (let ((first (make-overlay (point-min) (save-excursion
                                             (goto-char (point-min))
                                             (search-forward "First"))))
          (second (make-overlay (save-excursion
                                  (goto-char (point-min))
                                  (search-forward "Second")
                                  (line-beginning-position))
                                (point-max))))
      (overlay-put first 'category 'bndos-markdown-style)
      (overlay-put second 'category 'bndos-markdown-style)
      (setq-local bndos-markdown-style-overlays (list first second))
      (goto-char (point-max))
      (pcase-let ((`(,beg . ,end) (bndos-ein--edit-block-bounds)))
        (bndos-markdown-clear-previews beg end))
      (should (overlay-buffer first))
      (should-not (overlay-buffer second)))))

(ert-deftest bndos-ein-test-mret-anchors-before-rendering ()
  :tags '(ein-regression)
  (bndos-ein-test--load)
  (let ((anchor 'anchor-cell)
        rendered
        goto-anchor)
    (cl-letf (((symbol-function 'bndos-ein-markdown-context-p)
               (lambda () t))
              ((symbol-function 'bndos-ein--current-markdown-cell)
               (lambda () anchor))
              ((symbol-function 'bndos/ein-render-markdown)
               (lambda () (setq rendered t) 'different-cell-after-render))
              ((symbol-function 'bndos-ein-goto-next-input)
               (lambda (&optional cell) (setq goto-anchor cell))))
      (bndos/ein-run-cell-and-next))
    (should rendered)
    (should (eq goto-anchor anchor))))

(ert-deftest bndos-ein-test-goto-next-uses-anchor-cell-from-edit-buffer ()
  :tags '(ein-regression)
  (bndos-ein-test--load)
  (let* ((base (generate-new-buffer "*ein: test.ipynb*"))
         (edit (make-indirect-buffer base " *ein: test.ipynb*[ein:markdown]" t))
         (anchor-cell 'anchor-cell)
         (next-cell 'next-cell)
         goto-cell stale-node-used)
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (switch-to-buffer edit)
          (with-current-buffer edit
            (setq major-mode 'ein:markdown-mode)
            (cl-letf (((symbol-function 'bndos-ein--notebook-buffer)
                       (lambda () base))
                      ((symbol-function 'ein:worksheet-get-current-ewoc-node)
                       (lambda () (setq stale-node-used t) 'stale-node))
                      ((symbol-function 'ein:worksheet-goto-next-input)
                       (lambda (_node)
                         (error "stale ewoc node navigation must not be used")))
                      ((symbol-function 'ein:cell-next)
                       (lambda (cell)
                         (should (eq cell anchor-cell))
                         next-cell))
                      ((symbol-function 'ein:cell-goto)
                       (lambda (cell)
                         (setq goto-cell cell))))
              (bndos-ein-goto-next-input anchor-cell)))
          (should (eq goto-cell next-cell))
          (should-not stale-node-used))
      (when (buffer-live-p edit) (kill-buffer edit))
      (when (buffer-live-p base) (kill-buffer base)))))

(ert-deftest bndos-ein-test-gd-primes-python-lsp-temp-file ()
  :tags '(ein-regression)
  (bndos-ein-test--load)
  (let ((orig-require (symbol-function 'require))
        setup-called
        definition-called
        restarted-count)
    (with-temp-buffer
      (rename-buffer " *ein: http://127.0.0.1:9999/rabi_tutorial.ipynb*[python]" t)
      (let ((python-mode-hook nil))
        (python-mode))
      (insert "import numpy as np
np.linspace(0, 1, 3)
")
      (goto-char (point-min))
      (search-forward "linspace")
      (setq-local lsp-proxy-mode t)
      (setq-local buffer-file-name nil)
      (setq restarted-count 0)
      (cl-letf (((symbol-function 'require)
                 (lambda (feature &optional filename noerror)
                   (if (eq feature 'lsp-proxy)
                       t
                     (funcall orig-require feature filename noerror))))
                ((symbol-function 'lsp-proxy-mode)
                 (lambda (&optional arg)
                   (when (and arg (< arg 0))
                     (setq-local lsp-proxy-mode nil))
                   (when (or (null arg) (> arg 0))
                     (cl-incf restarted-count)
                     (setq-local lsp-proxy-mode t))))
                ((symbol-function 'bndos-ein--copilot-reopen)
                 (lambda () nil))
                ((symbol-function 'better-jumper-set-jump)
                 (lambda () nil))
                ((symbol-function 'lsp-proxy-find-definition)
                 (lambda ()
                   (interactive)
                   (setq definition-called t)
                   (should buffer-file-name)
                   (should (file-exists-p buffer-file-name)))))
        (cl-letf (((symbol-function 'bndos-ein-python-lsp-setup)
                   (let ((real (symbol-function 'bndos-ein-python-lsp-setup)))
                     (lambda ()
                       (setq setup-called t)
                       (funcall real)))))
          (bndos/lsp-find-definition)))
      (should setup-called)
      (should definition-called)
      (should buffer-file-name)
      (should (string-prefix-p (file-name-as-directory bndos-ein-lsp-temp-dir)
                               buffer-file-name))
      (should (= restarted-count 1)))))

(ert-deftest bndos-ein-test-markdown-cell-render-adds-style-overlays ()
  :tags '(ein-regression)
  (bndos-ein-test--load)
  (with-temp-buffer
    (insert "# Title\n\nSome `code`.\n")
    (let ((cell (list :min (point-min) :max (point-max))))
      (cl-letf (((symbol-function 'ein:cell-input-pos-min) (lambda (_cell) (plist-get cell :min)))
                ((symbol-function 'ein:cell-input-pos-max) (lambda (_cell) (plist-get cell :max)))
                ((symbol-function 'bndos-markdown-render-latex) (lambda (&rest _) 0)))
        (bndos-ein--render-cell cell)))
    (should (> (bndos-ein-test--overlay-count 'bndos-markdown-style-overlays) 0))))

(ert-deftest bndos-ein-test-markdown-edit-ret-is-generic-render-editor ()
  :tags '(ein-regression)
  (bndos-ein-test--load)
  (should (eq (lookup-key (evil-get-auxiliary-keymap ein:markdown-mode-map 'normal)
                          (kbd "RET"))
              'bndos/markdown-edit-at-point)))

(ert-deftest bndos-ein-test-edit-buffer-render-refreshes-visible-buffer ()
  :tags '(ein-regression)
  (bndos-ein-test--load)
  (let* ((base (generate-new-buffer "*ein: test.ipynb*"))
         (edit (make-indirect-buffer base " *ein: test.ipynb*[ein:markdown]" t))
         edit-rendered owner-rendered)
    (unwind-protect
        (with-current-buffer edit
          (setq major-mode 'ein:markdown-mode)
          (insert "| a | b |\n|---|---|\n| $x$ | `code` |\n")
          (cl-letf (((symbol-function 'ein:worksheet-get-current-cell)
                     (lambda (&rest _) 'fake-cell))
                    ((symbol-function 'ein:markdowncell-p)
                     (lambda (cell) (eq cell 'fake-cell)))
                    ((symbol-function 'bndos-ein--render-edit-block)
                     (lambda () (setq edit-rendered (current-buffer))))
                    ((symbol-function 'bndos-ein--render-cell)
                     (lambda (_cell) (setq owner-rendered (current-buffer)))))
            (bndos/ein-render-markdown)))
      (when (buffer-live-p edit) (kill-buffer edit))
      (when (buffer-live-p base) (kill-buffer base)))
    (should edit-rendered)
    (should owner-rendered)))

(ert-deftest bndos-ein-test-python-mret-executes-and-advances ()
  :tags '(ein-regression)
  (bndos-ein-test--load)
  (with-temp-buffer
    (rename-buffer " *ein: http://127.0.0.1:9999/rabi_tutorial.ipynb*[python]" t)
    (let ((python-mode-hook nil))
      (python-mode))
    (let (advanced executed)
      (cl-letf (((symbol-function 'bndos-ein-goto-next-input)
                 (lambda (&rest _) (setq advanced t)))
                ((symbol-function 'ein:worksheet-execute-cell)
                 (lambda (&rest _) (interactive) (setq executed t))))
        (bndos/ein-run-cell-and-next))
      (should executed)
      (should advanced))
    (should (= 0 (bndos-ein-test--overlay-count 'bndos-markdown-style-overlays)))
    (should (= 0 (bndos-ein-test--overlay-count 'bndos-markdown-latex-overlays)))))

(ert-deftest bndos-ein-test-latex-ranges-find-all-delimiters ()
  :tags '(ein-regression)
  (bndos-ein-test--load)
  (with-temp-buffer
    (insert "a $x$ b $$y$$ c \\[z\\] d \\$5 and $w$\n")
    (should (equal (mapcar (pcase-lambda (`(,_ ,_ ,formula ,display)) (cons formula display))
                           (bndos-markdown-latex-ranges (point-min) (point-max)))
                   '(("x") ("y" . t) ("z" . t) ("w"))))))

